{
 "doctype": "DocType",
 "name": "Class Booking",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "class_schedule",
  "member",
  "column_break_1",
  "class_date",
  "status",
  "section_break_1",
  "booked_on"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-CBK-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "class_schedule",
   "fieldtype": "Link",
   "label": "Class Schedule",
   "options": "Class Schedule",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "class_date",
   "fieldtype": "Date",
   "label": "Class Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Booked\nWaitlisted\nAttended\nNo-Show\nCancelled",
   "default": "Booked",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "booked_on",
   "fieldtype": "Datetime",
   "label": "Booked On",
   "default": "now",
   "read_only": 1
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  },
  {
   "role": "Gym Trainer",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
