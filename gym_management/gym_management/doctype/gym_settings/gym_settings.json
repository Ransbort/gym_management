  },
  {
   "fieldname": "column_break_12",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_payment_gateway",
   "fieldtype": "Link",
   "label": "Default Payment Gateway",
   "options": "Payment Gateway",
   "description": "e.g. your Paystack Gateway Setting record. Informational only, same as sports_complex's own field of the same name (neither app reads it back in code) - the actual gateway lookup at payment time is frappe_paystack's own Paystack Gateway Setting, matched by Company."
