{
 "doctype": "DocType",
 "name": "Gym Equipment",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "equipment_name",
  "category",
  "column_break_1",
  "brand",
  "serial_number",
  "section_break_1",
  "purchase_date",
  "purchase_cost",
  "column_break_2",
  "status",
  "location"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-EQP-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "equipment_name",
   "fieldtype": "Data",
   "label": "Equipment Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Category",
   "options": "Cardio\nStrength Machines\nFree Weights\nFunctional / Accessories",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "brand",
   "fieldtype": "Data",
   "label": "Brand"
  },
  {
   "fieldname": "serial_number",
   "fieldtype": "Data",
   "label": "Serial Number"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "purchase_date",
   "fieldtype": "Date",
   "label": "Purchase Date"
  },
  {
   "fieldname": "purchase_cost",
   "fieldtype": "Currency",
   "label": "Purchase Cost"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Operational\nUnder Maintenance\nRetired",
   "default": "Operational",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Floor Location"
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
