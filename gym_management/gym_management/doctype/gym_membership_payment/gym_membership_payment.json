{
 "doctype": "DocType",
 "name": "Gym Membership Payment",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "gym_membership",
  "member",
  "column_break_1",
  "amount",
  "mode_of_payment",
  "payment_date",
  "section_break_1",
  "reference_no",
  "collected_by",
  "column_break_2",
  "remarks"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-PAY-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "gym_membership",
   "fieldtype": "Link",
   "label": "Gym Membership",
   "options": "Gym Membership",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "read_only": 1,
   "fetch_from": "gym_membership.member",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "label": "Mode Of Payment",
   "options": "Mode of Payment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_date",
   "fieldtype": "Date",
   "label": "Payment Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference / Receipt No"
  },
  {
   "fieldname": "collected_by",
   "fieldtype": "Link",
   "label": "Collected By",
   "options": "User",
   "default": "__user",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
