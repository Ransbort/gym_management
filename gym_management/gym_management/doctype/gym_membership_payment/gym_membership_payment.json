   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
