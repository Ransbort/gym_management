{
 "doctype": "DocType",
 "name": "Gym Membership",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "member",
  "membership_plan",
  "column_break_1",
  "start_date",
  "end_date",
  "status",
  "section_break_1",
  "items",
  "section_break_2",
  "taxes_and_charges",
  "column_break_2",
  "net_total",
  "column_break_3",
  "tax_amount",
  "grand_total",
  "section_break_3",
  "payment_terms_template",
  "column_break_4",
  "cost_center",
  "section_break_4",
  "paid_amount",
  "column_break_5",
  "outstanding_amount",
  "payment_status",
  "section_break_5",
  "invoice_reference"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-MSHP-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "membership_plan",
   "fieldtype": "Link",
   "label": "Membership Plan",
   "options": "Membership Plan",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date",
   "read_only": 1,
   "description": "Auto-calculated from the plan's duration."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nExpired\nSuspended\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Order Line"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Gym Membership Item",
   "description": "Defaults to a single line for the Membership Plan above; add more for add-ons."
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Taxes & Totals"
  },
  {
   "fieldname": "taxes_and_charges",
   "fieldtype": "Link",
   "label": "Sales Taxes and Charges Template",
   "options": "Sales Taxes and Charges Template"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "net_total",
   "fieldtype": "Currency",
   "label": "Net Total",
   "read_only": 1
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "tax_amount",
   "fieldtype": "Currency",
   "label": "Tax Amount",
   "read_only": 1
  },
  {
   "fieldname": "grand_total",
   "fieldtype": "Currency",
   "label": "Grand Total",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "section_break_3",
   "fieldtype": "Section Break",
   "label": "Payment Terms"
  },
  {
   "fieldname": "payment_terms_template",
   "fieldtype": "Link",
   "label": "Payment Terms Template",
   "options": "Payment Terms Template"
  },
  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "Cost Center",
   "options": "Cost Center"
  },
  {
   "fieldname": "section_break_4",
   "fieldtype": "Section Break",
   "label": "Billing Status"
  },
  {
   "fieldname": "paid_amount",
   "fieldtype": "Currency",
   "label": "Paid Amount"
  },
  {
   "fieldname": "column_break_5",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "outstanding_amount",
   "fieldtype": "Currency",
   "label": "Outstanding Amount",
   "read_only": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Unpaid\nPartially Paid\nPaid",
   "default": "Unpaid",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_5",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "invoice_reference",
   "fieldtype": "Data",
   "label": "Invoice Reference",
   "description": "Optional free-text reference to an external invoice/receipt."
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
