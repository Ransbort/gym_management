{
 "doctype": "DocType",
 "name": "Gym Membership",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "member",
  "member_name",
  "customer",
  "column_break_1",
  "company",
  "date",
  "section_break_1",
  "is_admission_fee",
  "membership_plan",
  "membership_plan_type",
  "gym_services",
  "trainer",
  "column_break_2",
  "time_slot",
  "start_date",
  "valid_number_of_days",
  "section_break_2",
  "items",
  "section_break_3",
  "number_of_service",
  "net_total",
  "column_break_3",
  "mode_of_payment",
  "tax_amount",
  "section_break_4",
  "taxes_and_charges",
  "column_break_4",
  "grand_total",
  "cost_center",
  "section_break_5",
  "end_date",
  "status",
  "column_break_5",
  "paid_amount",
  "outstanding_amount",
  "payment_status",
  "section_break_6",
  "invoice_reference",
  "conversion_rate"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-MSHP-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "member_name",
   "fieldtype": "Data",
   "label": "Member Name",
   "fetch_from": "member.member_name",
   "read_only": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "hidden": 1,
   "print_hide": 1,
   "fetch_from": "member.customer",
   "read_only": 1,
   "description": "Mirrors the member's own Customer (Gym Member > Accounting), if one is linked. Kept in sync explicitly by create_membership() and the backfill repair, same as member_name above (fetch_from is Desk-JS only). Needed for frappe_paystack's PaystackPaymentLog.get_data(), which reads <linked doc>.customer to resolve a receipt email - without this field that access raises AttributeError, since Gym Membership otherwise has no customer attribute at all."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "default": "Today",
   "reqd": 1,
   "description": "Document date."
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Gym Membership Details"
  },
  {
   "fieldname": "is_admission_fee",
   "fieldtype": "Check",
   "label": "Is Admission Fee",
   "description": "If checked, the Admission Fee Item from Gym Settings is added as an Order Line at the Registration Fee amount."
  },
  {
   "fieldname": "membership_plan",
   "fieldtype": "Link",
   "label": "Membership Plan",
   "options": "Membership Plan",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "membership_plan_type",
   "fieldtype": "Link",
   "label": "Membership Plan Type",
   "options": "Membership Plan Type",
   "reqd": 1
  },
  {
   "fieldname": "gym_services",
   "fieldtype": "Table MultiSelect",
   "label": "Gym Services",
   "options": "Gym Membership Service"
  },
  {
   "fieldname": "trainer",
   "fieldtype": "Link",
   "label": "Trainer",
   "options": "Trainer",
   "reqd": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "time_slot",
   "fieldtype": "Data",
   "label": "Time Slot",
   "reqd": 1
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Activation Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "valid_number_of_days",
   "fieldtype": "Int",
   "label": "Valid Number of Days",
   "reqd": 1,
   "description": "Gym Admission will expire, if not renewed membership before this day."
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Order Line"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Gym Membership Item",
   "description": "Defaults to a single line for the Membership Plan above; add more for add-ons."
  },
  {
   "fieldname": "section_break_3",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "number_of_service",
   "fieldtype": "Int",
   "label": "Number of Service",
   "default": 1
  },
  {
   "fieldname": "net_total",
   "fieldtype": "Currency",
   "label": "Untaxed Amount",
   "read_only": 1
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "label": "Mode Of Payment",
   "options": "Mode of Payment",
   "reqd": 1
  },
  {
   "fieldname": "tax_amount",
   "fieldtype": "Currency",
   "label": "Tax Amount",
   "read_only": 1
  },
  {
   "fieldname": "section_break_4",
   "fieldtype": "Section Break",
   "label": "Taxes & Totals"
  },
  {
   "fieldname": "taxes_and_charges",
   "fieldtype": "Link",
   "label": "Sales Taxes and Charges Template",
   "options": "Sales Taxes and Charges Template"
  },
  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "grand_total",
   "fieldtype": "Currency",
   "label": "Grand Total",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "Cost Center",
   "options": "Cost Center"
  },
  {
   "fieldname": "section_break_5",
   "fieldtype": "Section Break",
   "label": "Billing Status"
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date",
   "read_only": 1,
   "description": "Auto-calculated from Valid Number of Days (falls back to the plan's duration if that's not set)."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nExpired\nSuspended\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_5",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "paid_amount",
   "fieldtype": "Currency",
   "label": "Paid Amount"
  },
  {
   "fieldname": "outstanding_amount",
   "fieldtype": "Currency",
   "label": "Outstanding Amount",
   "read_only": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Unpaid\nPartially Paid\nPaid",
   "default": "Unpaid",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_6",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "invoice_reference",
   "fieldtype": "Data",
   "label": "Invoice Reference",
   "description": "Optional free-text reference to an external invoice/receipt."
  },
  {
   "fieldname": "conversion_rate",
   "fieldtype": "Float",
   "label": "Conversion Rate",
   "default": 1,
   "hidden": 1,
   "print_hide": 1,
   "description": "Currency conversion rate against the company currency. Always 1 here (Gym Membership is single-currency); this field exists only because frappe_paystack's PaystackPaymentLog.get_data() multiplies amount by <linked doc>.conversion_rate when building the checkout page, and errors out (float * None) if the field is missing."
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
