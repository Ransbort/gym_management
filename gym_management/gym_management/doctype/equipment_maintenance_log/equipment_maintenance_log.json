{
 "doctype": "DocType",
 "name": "Equipment Maintenance Log",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "gym_equipment",
  "maintenance_type",
  "column_break_1",
  "maintenance_date",
  "performed_by",
  "cost",
  "section_break_1",
  "equipment_status_after",
  "column_break_2",
  "next_due_date",
  "section_break_2",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-EML-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "gym_equipment",
   "fieldtype": "Link",
   "label": "Gym Equipment",
   "options": "Gym Equipment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "maintenance_type",
   "fieldtype": "Select",
   "label": "Maintenance Type",
   "options": "Routine\nRepair\nInspection",
   "default": "Routine",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "maintenance_date",
   "fieldtype": "Date",
   "label": "Maintenance Date",
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "performed_by",
   "fieldtype": "Data",
   "label": "Performed By"
  },
  {
   "fieldname": "cost",
   "fieldtype": "Currency",
   "label": "Cost"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "equipment_status_after",
   "fieldtype": "Select",
   "label": "Equipment Status After This Log",
   "options": "Operational\nUnder Maintenance\nRetired",
   "default": "Operational"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "next_due_date",
   "fieldtype": "Date",
   "label": "Next Due Date"
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
