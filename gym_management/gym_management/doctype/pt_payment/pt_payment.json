{
 "doctype": "DocType",
 "name": "PT Payment",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "pt_package_purchase",
  "member",
  "column_break_1",
  "payment_type",
  "amount",
  "mode_of_payment",
  "payment_date",
  "section_break_1",
  "reference_no",
  "collected_by",
  "column_break_2",
  "remarks",
  "journal_entry"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-PTPAY-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "pt_package_purchase",
   "fieldtype": "Link",
   "label": "Pt Package Purchase",
   "options": "PT Package Purchase",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "read_only": 1,
   "fetch_from": "pt_package_purchase.member",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "payment_type",
   "fieldtype": "Select",
   "label": "Payment Type",
   "options": "Payment\nRefund",
   "default": "Payment",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Refund: pays back a member with a credit balance (e.g. after an overpayment) - subtracts from paid_amount instead of adding to it."
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "label": "Mode Of Payment",
   "options": "Mode of Payment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_date",
   "fieldtype": "Date",
   "label": "Payment Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference / Receipt No"
  },
  {
   "fieldname": "collected_by",
   "fieldtype": "Link",
   "label": "Collected By",
   "options": "User",
   "default": "__user",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "journal_entry",
   "fieldtype": "Link",
   "label": "Journal Entry",
   "options": "Journal Entry",
   "read_only": 1,
   "description": "Set automatically by create_accounting_entry() once this payment has been posted to the Chart of Accounts (see Gym Settings > Default Income Account). Blank if that setting is empty or the Mode of Payment used has no default account configured."
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1,
   "import": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "import": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ],
 "allow_import": 1
}
