{
 "doctype": "DocType",
 "name": "Trainer",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "trainer_name",
  "photo",
  "column_break_1",
  "email",
  "phone",
  "user",
  "section_break_1",
  "employee_code",
  "department",
  "column_break_2",
  "date_of_joining",
  "employment_status",
  "section_break_2",
  "specializations",
  "column_break_3",
  "bio"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-TRN-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "trainer_name",
   "fieldtype": "Data",
   "label": "Trainer Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "photo",
   "fieldtype": "Attach Image",
   "label": "Photo"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email",
   "in_list_view": 1
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone",
   "options": "Phone"
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "description": "Optional: link to a login for this trainer."
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Employment"
  },
  {
   "fieldname": "employee_code",
   "fieldtype": "Data",
   "label": "Employee ID"
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "label": "Department",
   "options": "Gym Department"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "date_of_joining",
   "fieldtype": "Date",
   "label": "Date Of Joining"
  },
  {
   "fieldname": "employment_status",
   "fieldtype": "Select",
   "label": "Employment Status",
   "options": "Active\nInactive",
   "default": "Active",
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "specializations",
   "fieldtype": "Small Text",
   "label": "Specializations",
   "description": "Comma-separated, e.g. Yoga, HIIT, Strength Training, Nutrition Coaching"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "bio",
   "fieldtype": "Text",
   "label": "Bio"
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  },
  {
   "role": "Gym Trainer",
   "read": 1,
   "print": 1,
   "report": 1
  }
 ]
}
