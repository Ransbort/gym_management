{
 "doctype": "DocType",
 "name": "Membership Renewal",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "membership",
  "member",
  "column_break_1",
  "previous_end_date",
  "new_end_date",
  "renewal_date",
  "section_break_1",
  "amount",
  "column_break_2",
  "payment_status",
  "invoice_reference"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-REN-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "membership",
   "fieldtype": "Link",
   "label": "Membership",
   "options": "Gym Membership",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Data",
   "label": "Member",
   "fetch_from": "membership.member",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "previous_end_date",
   "fieldtype": "Date",
   "label": "Previous End Date",
   "read_only": 1
  },
  {
   "fieldname": "new_end_date",
   "fieldtype": "Date",
   "label": "New End Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "renewal_date",
   "fieldtype": "Date",
   "label": "Renewal Date",
   "default": "Today"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Billing"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Unpaid\nPartially Paid\nPaid",
   "default": "Unpaid"
  },
  {
   "fieldname": "invoice_reference",
   "fieldtype": "Data",
   "label": "Invoice Reference"
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
