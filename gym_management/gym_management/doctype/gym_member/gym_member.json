{
 "doctype": "DocType",
 "name": "Gym Member",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "member_name",
  "photo",
  "column_break_1",
  "gender",
  "date_of_birth",
  "section_break_1",
  "email",
  "phone",
  "column_break_2",
  "address",
  "section_break_2",
  "emergency_contact_name",
  "column_break_3",
  "emergency_contact_phone",
  "section_break_3",
  "date_joined",
  "membership_status",
  "column_break_4",
  "health_notes"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-MEM-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "member_name",
   "fieldtype": "Data",
   "label": "Member Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "photo",
   "fieldtype": "Attach Image",
   "label": "Photo"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "gender",
   "fieldtype": "Select",
   "label": "Gender",
   "options": "Male\nFemale\nOther",
   "in_list_view": 1
  },
  {
   "fieldname": "date_of_birth",
   "fieldtype": "Date",
   "label": "Date Of Birth"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email",
   "in_list_view": 1
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone",
   "options": "Phone",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "address",
   "fieldtype": "Small Text",
   "label": "Address"
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Emergency Contact"
  },
  {
   "fieldname": "emergency_contact_name",
   "fieldtype": "Data",
   "label": "Emergency Contact Name"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "emergency_contact_phone",
   "fieldtype": "Data",
   "label": "Emergency Contact Phone",
   "options": "Phone"
  },
  {
   "fieldname": "section_break_3",
   "fieldtype": "Section Break",
   "label": "Membership"
  },
  {
   "fieldname": "date_joined",
   "fieldtype": "Date",
   "label": "Date Joined",
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "membership_status",
   "fieldtype": "Select",
   "label": "Membership Status",
   "options": "Active\nExpired\nSuspended\nCancelled\nNo Membership",
   "default": "No Membership",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Kept in sync automatically from this member's Gym Membership records."
  },
  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "health_notes",
   "fieldtype": "Small Text",
   "label": "Health Notes",
   "description": "Optional, self-reported: injuries, conditions or restrictions relevant to training."
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  },
  {
   "role": "Gym Trainer",
   "read": 1,
   "print": 1,
   "report": 1
  }
 ]
}
