{
 "doctype": "DocType",
 "name": "PT Session",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "pt_package_purchase",
  "member",
  "trainer",
  "column_break_1",
  "session_date",
  "start_time",
  "duration_minutes",
  "section_break_1",
  "status",
  "column_break_2",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-PTS-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "pt_package_purchase",
   "fieldtype": "Link",
   "label": "Pt Package Purchase",
   "options": "PT Package Purchase",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "fetch_from": "pt_package_purchase.member",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "trainer",
   "fieldtype": "Link",
   "label": "Trainer",
   "options": "Trainer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "session_date",
   "fieldtype": "Date",
   "label": "Session Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "start_time",
   "fieldtype": "Time",
   "label": "Start Time"
  },
  {
   "fieldname": "duration_minutes",
   "fieldtype": "Int",
   "label": "Duration Minutes",
   "default": 60
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Scheduled\nCompleted\nCancelled\nNo-Show",
   "default": "Scheduled",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  },
  {
   "role": "Gym Trainer",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}
