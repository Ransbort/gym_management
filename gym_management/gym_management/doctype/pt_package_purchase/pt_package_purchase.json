{
 "doctype": "DocType",
 "name": "PT Package Purchase",
 "module": "Gym Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "member",
  "pt_package",
  "column_break_1",
  "purchase_date",
  "expiry_date",
  "status",
  "section_break_1",
  "sessions_total",
  "column_break_2",
  "sessions_used",
  "sessions_remaining",
  "section_break_2",
  "company",
  "amount",
  "column_break_3",
  "paid_amount",
  "outstanding_amount",
  "section_break_3",
  "payment_status",
  "column_break_4",
  "invoice_reference",
  "section_break_4",
  "customer",
  "currency",
  "conversion_rate"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "GM-PTP-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Member",
   "options": "Gym Member",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "pt_package",
   "fieldtype": "Link",
   "label": "Pt Package",
   "options": "PT Package",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "purchase_date",
   "fieldtype": "Date",
   "label": "Purchase Date",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "expiry_date",
   "fieldtype": "Date",
   "label": "Expiry Date",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nExpired\nCompleted",
   "default": "Active",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Sessions"
  },
  {
   "fieldname": "sessions_total",
   "fieldtype": "Int",
   "label": "Sessions Total",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "sessions_used",
   "fieldtype": "Int",
   "label": "Sessions Used",
   "read_only": 1
  },
  {
   "fieldname": "sessions_remaining",
   "fieldtype": "Int",
   "label": "Sessions Remaining",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Billing"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "paid_amount",
   "fieldtype": "Currency",
   "label": "Paid Amount",
   "read_only": 1,
   "description": "Only ever moved by a real PT Payment record (see collect_pt_payment()), same audit-trail pattern as Gym Membership.paid_amount."
  },
  {
   "fieldname": "outstanding_amount",
   "fieldtype": "Currency",
   "label": "Outstanding Amount",
   "read_only": 1
  },
  {
   "fieldname": "section_break_3",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Unpaid\nPartially Paid\nPaid",
   "default": "Unpaid",
   "read_only": 1,
   "in_list_view": 1,
   "description": "Computed from Paid Amount on every save - see calculate_payment_status(). No longer directly settable (a PT Payment record is what actually moves it)."
  },
  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "invoice_reference",
   "fieldtype": "Data",
   "label": "Invoice Reference"
  },
  {
   "fieldname": "section_break_4",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "hidden": 1,
   "print_hide": 1,
   "fetch_from": "member.customer",
   "read_only": 1,
   "description": "Mirrors the member's own Customer (Gym Member > Accounting), if one is linked. Set explicitly by create_pt_purchase() (fetch_from is Desk-JS only). Needed for frappe_paystack's PaystackPaymentLog.get_data(), same reason as Gym Membership.customer."
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "hidden": 1,
   "print_hide": 1,
   "fetch_from": "company.default_currency",
   "read_only": 1,
   "description": "Set explicitly by create_pt_purchase() from the Company's default currency - same story as Gym Membership.currency."
  },
  {
   "fieldname": "conversion_rate",
   "fieldtype": "Float",
   "label": "Conversion Rate",
   "default": 1,
   "hidden": 1,
   "print_hide": 1,
   "description": "Always 1 here (single-currency). Exists only because frappe_paystack's PaystackPaymentLog.get_data() multiplies amount by <linked doc>.conversion_rate - same story as Gym Membership.conversion_rate."
  }
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Gym Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Gym Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "report": 1
  },
  {
   "role": "Gym Trainer",
   "read": 1,
   "print": 1,
   "report": 1
  }
 ]
}
